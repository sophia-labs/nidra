<urn:ao:sql_query/id=73d803c7-3724-4309-a5a4-20b97f901adf> <urn:ao:sql_query#sql_full_query> "SELECT f.title, count(r.rental_id) AS rentals FROM rental r JOIN inventory i ON i.inventory_id = r.inventory_id JOIN film f ON f.film_id = i.film_id GROUP BY f.title ORDER BY rentals DESC" .
