{
  "serviceId": "nidra",
  "displayName": "Nidra",
  "command": "node",
  "args": [
    "main.mjs"
  ],
  "requires": {
    "node": "22.19"
  },
  "workingDir": ".",
  "healthPath": "/health",
  "proxyMount": "/services/nidra",
  "autostart": false,
  "memberAccess": "all",
  "mcp": {
    "path": "/mcp",
    "graphs": [
      "nidra"
    ],
    "toolPrefix": "nidra_",
    "timeoutMs": 120000
  },
  "env": [
    {
      "name": "NODE_ENV",
      "value": "production"
    }
  ],
  "agentMemory": true
}
